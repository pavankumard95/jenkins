pipeline{
    agent any
    
    stages{
        stage('Checkout'){
            steps{
                echo "Checking out"
            }
        }
        stage('Build'){
            steps{
                echo "Building"
            }
        }
        stage('Test'){
            steps{
                echo "Checking out"
            }
        }
        stage('Deploy'){
            steps{
                echo "Deploying"
            }
        }
    }
}