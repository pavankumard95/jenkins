pipeline{
    agent any 

    stages{
        stage('Checkout'){
            steps{
                git branch: 'main', credentialsId: 'github', url: 'https://github.com/pavankumard95/calc.git' 
            }
        }
        stage('Validate'){
            steps{
                sh "mvn validate"
            }
        }
        stage('Compile'){
            steps{
                sh "mvn compile"
            }
        }
        stage('Test'){
            steps{
                sh "mvn test"
            }
        }
        stage('Package'){
            steps{
                sh "mvn package"
            }
        }
        stage('Intergration test'){
            steps{
                sh "mvn test"
            }
        }
        stage('Install'){
            steps{
                sh "mvn clean install"
            }
        }
        stage('Deploy'){
            steps{
                sh "mvn deploy"
            }
        }
    }
}

