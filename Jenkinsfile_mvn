pipeline{
    agent any 

    stages{
        stage('Checkout'){
            steps{
                git branch: 'main', credentialsId: 'github', url: 'https://github.com/pavankumard95/calc.git' 
            }
        }
        stage('Validate'){
            steps{
                sh "mvn -B validate checkstyle:check"
            }
        }
        stage('Compile'){
            steps{
                sh "mvn -B clean compile"
            }
        }
        stage('Unit test'){
            steps{
                sh "mvn -B test"
            }
        }
        stage('Package'){
            steps{
                sh "mvn -B package -DskipTests"
            }
        }
        stage('Intergration test'){
            steps{
                sh "mvn -B verify -DskipUTs"
            }
        }
        stage('Deploy'){
            steps{
                withCredentials{[usernamePassword{
                    credentialsId: 'tomcat-manager',
                    usernameVariable: 'TOMCAT_USERNAME',
                    passwordVariable: 'TOMCAT_PASSWORD'
                }]}{
                sh'''
                    set +x
                    mvn -B cargo:redeploy -DskipTests
                    curl http://localhost:8081/calculator/
                    '''
                }
            }
        }
    }
}

